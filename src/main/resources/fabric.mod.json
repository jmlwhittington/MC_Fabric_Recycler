{
  "schemaVersion": 1,
  "id": "recycler",
  "version": "${version}",
  "name": "Recycler",
  "description": "A vanilla-styled machine for recovering some ingredients from items! Dynamically pulls from recipe table, plus custom rules config!",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.recycler.RecyclerMod"
    ],
    "client": [
      "com.recycler.RecyclerClient"
    ]
  },
  "mixins": [
    "recycler.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
	"fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
